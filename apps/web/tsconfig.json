{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // The legacy planner (src/*.js) is imported from the shell; its types are inferred, not checked yet.
    "allowJs": true,
    "checkJs": false,
    // The legacy sources import their TypeScript modules by the .ts name (Node strips the types, see ../../tsconfig.json).
    "allowImportingTsExtensions": true,
    // The legacy planner sources (repository src/) until they move into packages.
    "paths": { "@legacy/*": ["../../src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
