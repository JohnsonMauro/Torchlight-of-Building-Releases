{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // The legacy planner (src/*.js) is imported from the shell; its types are inferred, not checked yet.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "vite.config.ts"]
}
