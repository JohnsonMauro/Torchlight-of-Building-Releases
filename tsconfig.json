{
  // TypeScript in the planner sources (src/**/*.ts) and the Node tests. Node runs these files directly by stripping
  // the types, so only erasable syntax is allowed and imports name the .ts file. The web app has its own
  // apps/web/tsconfig.json.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // The .ts modules import legacy src/*.js: their types are inferred, not checked yet (as in apps/web).
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
