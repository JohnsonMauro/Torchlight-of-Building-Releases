{
  "name": "tli-planner",
  "productName": "TLI Planner",
  "description": "Build planner and damage calculator for Torchlight: Infinite",
  "author": "Johnson Mauro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#engine": "./packages/engine/src/index.ts"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "desktop": "pnpm build:web && node scripts/electron.js",
    "build:win": "pnpm build:web && electron-builder --win nsis portable --publish never",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/web && tsc -p .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "pnpm build:web && playwright test",
    "test:desktop": "pnpm build:web && playwright test -c playwright.desktop.config.js",
    "golden:update": "node tests/golden/update.js",
    "golden:diff": "node tests/golden/diff.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.johnsonmauro.tli-planner",
    "productName": "TLI Planner",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "dist-web/**",
      "!dist-web/**/*.map",
      "src/**/*.{js,ts}",
      "packages/engine/**/*.{js,ts,json}",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TLI-Planner-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TLI-Planner-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "JohnsonMauro",
      "repo": "Torchlight-of-Building-Releases",
      "releaseType": "release"
    }
  },
  "license": "MIT",
  "packageManager": "pnpm@12.16.1"
}
