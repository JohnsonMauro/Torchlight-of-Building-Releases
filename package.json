{
  "name": "tli-builder",
  "productName": "Torchlight of Building",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/serve.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis portable --publish never",
    "test": "node --test \"tests/**/*.test.js\"",
    "golden:update": "node tests/golden/update.js",
    "golden:diff": "node tests/golden/diff.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tlibuilder.planner",
    "productName": "Torchlight of Building",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "index.html",
      "src/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TLI-Build-Planner-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TLI-Build-Planner-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "TomSelleck09",
      "repo": "Torchlight-of-Building-Releases",
      "releaseType": "release"
    }
  },
  "license": "MIT"
}
