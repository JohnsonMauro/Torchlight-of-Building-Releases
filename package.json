{
  "name": "tli-builder",
  "productName": "Torchlight of Building",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "desktop": "pnpm build:web && node scripts/electron.js",
    "build:win": "pnpm build:web && electron-builder --win nsis portable --publish never",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/web",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "pnpm build:web && playwright test",
    "test:desktop": "pnpm build:web && playwright test -c playwright.desktop.config.js",
    "golden:update": "node tests/golden/update.js",
    "golden:diff": "node tests/golden/diff.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.tlibuilder.planner",
    "productName": "Torchlight of Building",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "dist-web/**",
      "src/**/*.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TLI-Build-Planner-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TLI-Build-Planner-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "TomSelleck09",
      "repo": "Torchlight-of-Building-Releases",
      "releaseType": "release"
    }
  },
  "license": "MIT",
  "packageManager": "pnpm@12.11.2"
}
